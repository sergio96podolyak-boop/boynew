{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Trading Bot (Paper)",
      "runtimeExecutable": "./venv/bin/python",
      "runtimeArgs": [
        "main.py"
      ],
      "port": 8501
    },
    {
      "name": "Trading Bot (Live)",
      "runtimeExecutable": "./venv/bin/python",
      "runtimeArgs": [
        "main.py",
        "--live"
      ],
      "port": 8501
    },
    {
      "name": "Trading Bot (No Dashboard)",
      "runtimeExecutable": "./venv/bin/python",
      "runtimeArgs": [
        "main.py",
        "--no-dashboard"
      ]
    },
    {
      "name": "Streamlit Dashboard",
      "runtimeExecutable": "./venv/bin/streamlit",
      "runtimeArgs": [
        "run",
        "dashboard.py",
        "--server.port=8501"
      ],
      "port": 8501
    },
    {
      "name": "Web App (Dev)",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "grocery-manager-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "/Users/sergiopodolyak/grocery-manager/frontend",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "PoMarket (Web)",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd market_bloom/build/web && python3 -m http.server 5959"
      ],
      "port": 5959,
      "url": "http://localhost:5959"
    },
    {
      "name": "Dashboard Preview (8511)",
      "runtimeExecutable": "./venv/bin/streamlit",
      "runtimeArgs": [
        "run",
        "dashboard.py",
        "--server.port=8511",
        "--server.headless=true",
        "--server.enableCORS=false",
        "--server.enableXsrfProtection=false"
      ],
      "port": 8511
    }
  ]
}
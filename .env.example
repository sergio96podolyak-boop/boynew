# Copy to .env and fill secrets. Bot reads these on startup.

# --- API (required for live) ---
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# true = simulated balance, no real orders | false = REAL MONEY on Binance Futures
PAPER_TRADING=true

# Live mode is double-locked. To run real Binance Futures orders, all three are required:
#   PAPER_TRADING=false
#   LIVE_TRADING_ENABLED=true
#   LIVE_TRADING_CONFIRMATION=I_ACCEPT_REAL_BINANCE_FUTURES_RISK
# Keep these conservative until the system has a long paper/testnet track record.
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRMATION=
LIVE_MAX_LEVERAGE=5
LIVE_MAX_MARGIN_FRACTION=0.10
LIVE_REQUIRED_MIN_EQUITY_USDT=25

# --- Mode ---
# Aggressive HFT: continuous scan, rank, enter/exit (default on)
AGGRESSIVE_HFT=true

# Classic symbols (also used as hints when HFT merges universe)
SYMBOLS=BTCUSDT,ETHUSDT

# Paper starting balance (USDT)
INITIAL_BALANCE=10000
PAPER_RESET_OPEN_TRADES_ON_START=true

# --- Risk & leverage (automatic limits — no babysitting) ---
CONFIDENCE_THRESHOLD=0.68
LEVERAGE=5
MAX_DRAWDOWN_PCT=0.10
DAILY_MAX_DRAWDOWN_PCT=0.05
MAX_MARGIN_FRACTION_PER_POSITION=0.30
HFT_MAX_OPEN_POSITIONS=2
# Minimum position size in USDT (qty × price). Default 5 matches common Binance MIN_NOTIONAL (fewer rejections).
HFT_MIN_NOTIONAL_USDT=5
ABNORMAL_LOSS_PCT_PER_TRADE=0.02

# Blacklist a symbol whose cumulative loss (USDT, 48h lookback) is this deep,
# even if its win rate looks OK. 0 disables. Catches "50% win rate but huge losses".
SYMBOL_BLACKLIST_MAX_LOSS_USDT=2.0

# --- Aggressive tiers (fraction of balance → sized via risk.evaluate) ---
SIZE_BASE_PCT=0.10
SIZE_HIGH_PCT=0.20
SIZE_EXTREME_PCT=0.30
SCORE_ENTRY=72
SCORE_HIGH=85
SCORE_EXTREME=92

# High conviction: bigger size only when score/consensus/funding/drawdown all agree.
HIGH_CONVICTION_ENABLED=true
HIGH_CONVICTION_MIN_SCORE=96
HIGH_CONVICTION_MIN_CONSENSUS=0.85
HIGH_CONVICTION_MAX_FUNDING_PENALTY=1.0
HIGH_CONVICTION_SIZE_MULTIPLIER=1.20
HIGH_CONVICTION_MAX_DRAWDOWN_PCT=0.03
HIGH_CONVICTION_PROFIT_TAKE_MULTIPLIER=1.35

# Capital allocator: can boost size only for rare high-score, low-funding-risk setups.
CAPITAL_ALLOCATOR_ENABLED=true
CAPITAL_ALLOCATOR_MIN_SCORE=98
CAPITAL_ALLOCATOR_MAX_FUNDING_PENALTY=1.0
CAPITAL_ALLOCATOR_SIZE_MULTIPLIER=1.35
CAPITAL_ALLOCATOR_MAX_OPEN_POSITIONS=1

# Trend runner: lets strong winners breathe instead of taking profit too early.
TREND_RUNNER_ENABLED=true
TREND_RUNNER_MIN_SCORE=92
TREND_RUNNER_PROFIT_TAKE_MULTIPLIER=1.80
TREND_RUNNER_TP_MULTIPLIER=1.45
TREND_RUNNER_TP_MAX_PCT=0.050
TREND_RUNNER_LOCK_TRIGGER_PCT=0.009
TREND_RUNNER_RETRACE_PCT=0.003
TREND_RUNNER_MIN_AGE_SECONDS=90

DRAWDOWN_SIZE_REDUCTION_ENABLED=true
DRAWDOWN_SIZE_REDUCTION_START_PCT=0.06
DRAWDOWN_SIZE_MULTIPLIER=0.70

# --- Stops & exits ---
# Stale exit: 0 = off. Default 900s (15m) gives trades room to develop before "no movement" close.
STALE_EXIT_SECONDS=900
MIN_FAVORABLE_MOVE_PCT=0.0002
SL_MIN_PCT=0.003
SL_MAX_PCT=0.007
TP_MIN_PCT=0.003
TP_MAX_PCT=0.015
HFT_TRAILING_PCT=0.002
PROFIT_LOCK_ENABLED=true
PROFIT_LOCK_TRIGGER_PCT=0.004
PROFIT_LOCK_RETRACE_PCT=0.0015
PROFIT_LOCK_MIN_NET_PCT=0.001
PROFIT_TAKE_PCT=0.010
PROFIT_TAKE_MIN_AGE_SECONDS=45
ESTIMATED_TAKER_FEE_PCT=0.0005
PROFIT_EDGE_BUFFER_PCT=0.0005
FEE_AWARE_SIZING_ENABLED=true
# Require the planned take-profit to be meaningful after fees/slippage.
# If this can be met inside risk caps, notional is lifted; otherwise entry is rejected.
MIN_EXPECTED_NET_PROFIT_USDT=0.25
MIN_NET_REWARD_RISK=1.15
MIN_PROFIT_COST_RATIO=3.0

# --- Scanning ---
SCAN_TOP_N=120
NEW_LISTING_SCAN_ENABLED=true
NEW_LISTING_MAX_AGE_DAYS=30
NEW_LISTING_TOP_N=35
NEW_LISTING_MIN_QUOTE_VOLUME_USDT=3000000
MOMENTUM_SCAN_ENABLED=true
MOMENTUM_TOP_N=60
MOMENTUM_MIN_QUOTE_VOLUME_USDT=3000000
MOMENTUM_MIN_PRICE_CHANGE_PCT=3

# DEX Watch (Hyperliquid, read-only) -> scanner injection. Hot DEX movers that
# also trade on Binance futures join the scan universe; all entry gates still apply.
DEX_HOT_SCAN_ENABLED=true
DEX_HOT_TOP_N=12

# Fee guard: commissions can out-bleed the market (measured 69% of losses).
# Budget entries per hour; per-symbol cooldown after any exit. 0 disables.
MAX_ENTRIES_PER_HOUR=6
SYMBOL_REENTRY_COOLDOWN_SECONDS=600

# Performance escalator: earned aggression. Size scales up ONLY after the last
# PERF_ESCALATOR_HOURS window proves a positive edge (profit factor), and scales
# down while it is negative. Checked every analyzer refresh, no calendar waiting.
PERF_ESCALATOR_ENABLED=true
PERF_ESCALATOR_HOURS=24
PERF_ESCALATOR_MIN_TRADES=20
DISCOVERY_SCORE_BONUS_MAX=5
HFT_TIMEFRAME=1m
HFT_FETCH_LIMIT=200
MIN_ML_TRAINING_CANDLES=240
TECHNICAL_FALLBACK_SIGNALS=true
TECHNICAL_FALLBACK_MIN_SCORE=78
# If ML has no demonstrated edge, require stronger technical confluence.
TECHNICAL_FALLBACK_STRONG_MODE=true
TECHNICAL_FALLBACK_STRONG_MIN_SCORE=88
TECHNICAL_FALLBACK_VOLUME_MULT=1.25
MIN_SYMBOL_PRICE_USDT=0.05
LOOP_SLEEP_MS=50
ORDER_RETRY_MAX=5

# --- Funding / underlying market-hours risk ---
MAX_ABS_FUNDING_RATE=0.0015
CROWDED_FUNDING_RATE=0.0005
FUNDING_AVOID_MINUTES=20
FUNDING_WINDOW_SCORE_PENALTY=5
FUNDING_SIZE_MULTIPLIER=0.75
BLOCK_STOCK_LIKE_PERPS_OUTSIDE_PRIMARY_HOURS=true

# --- Multi-agent decision committee ---
DECISION_MIN_CONSENSUS=0.67
DECISION_LIVE_MIN_CONSENSUS=0.80
DECISION_MIN_SCORE_AFTER_GUARDS=70
BLOCK_WHEN_MODEL_UNHEALTHY=true
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_SECONDS=45
HEALTH_REPAIR_PROTECTION_ENABLED=true
BLOCK_ON_STALE_NEWS=false
NEWS_MAX_AGE_SECONDS=900
NEWS_REFRESH_SECONDS=120
NEWS_NEGATIVE_HEADLINE_BLOCK=true
CATALYST_AGENT_ENABLED=true
CATALYST_REFRESH_SECONDS=90
CATALYST_MAX_AGE_SECONDS=900
CATALYST_SCORE_BOOST=3
CATALYST_MAX_DATED_EVENT_LAG_DAYS=3
CATALYST_NEGATIVE_BLOCK=true
MARKET_REGIME_REFRESH_SECONDS=45
MARKET_REGIME_SYMBOL=BTCUSDT
MARKET_REGIME_TIMEFRAME=15m
MARKET_REGIME_FETCH_LIMIT=120
REGIME_BLOCK_LONGS_DROP_PCT=0.012
REGIME_BLOCK_SHORTS_RALLY_PCT=0.012
REGIME_HIGH_VOLATILITY_PCT=0.018
REGIME_RISK_OFF_SIZE_MULT=0.50

# --- Order-flow / positioning agent ---
FLOW_AGENT_ENABLED=true
FLOW_REFRESH_SECONDS=45
FLOW_PERIOD=5m
FLOW_LOOKBACK=4
FLOW_MIN_OI_CHANGE_PCT=0.003
FLOW_TAKER_BUY_RATIO=1.08
FLOW_TAKER_SELL_RATIO=0.92
FLOW_STRONG_TAKER_RATIO=1.20
FLOW_SCORE_BOOST=4
FLOW_SCORE_PENALTY=5
FLOW_SIZE_PENALTY=0.80
FLOW_CROWDED_LONG_RATIO=2.50
FLOW_CROWDED_SHORT_RATIO=0.40
FLOW_HARD_BLOCK_OPPOSITE=false

# --- Indirect advanced strategies (advisory, routed through risk controls) ---
INDIRECT_STRATEGIES_ENABLED=true
INDIRECT_GRID_ENABLED=true
INDIRECT_GRID_MIN_CHOPPINESS=48
INDIRECT_GRID_MAX_ADX=28
INDIRECT_GRID_LOWER_BBP=0.35
INDIRECT_GRID_UPPER_BBP=0.65
INDIRECT_GRID_CHASE_BBP=0.78
INDIRECT_GRID_SCORE_BOOST=2.5
INDIRECT_GRID_EDGE_PENALTY=4.0
INDIRECT_DCA_ENABLED=true
INDIRECT_DCA_PULLBACK_MIN_PCT=0.0008
INDIRECT_DCA_SCORE_BOOST=1.5
INDIRECT_ARB_ENABLED=true
INDIRECT_ARB_SCORE_BOOST=1.5
INDIRECT_MARTINGALE_INVERSE_ENABLED=true
INDIRECT_MARTINGALE_DRAWDOWN_CUT_PCT=0.025
INDIRECT_MAX_SCORE_BOOST=5.0
INDIRECT_MAX_SIZE_BOOST=1.08

# --- Strategy Lab / research gate (does not place orders) ---
STRATEGY_LAB_ENABLED=true
STRATEGY_LAB_REFRESH_LOOPS=50
STRATEGY_LAB_LOOKBACK_HOURS=48
STRATEGY_LAB_MIN_LIVE_TRADES=30

# --- Binance multi-product opportunity radar (dashboard only, no auto-entry) ---
OPPORTUNITY_RADAR_ENABLED=true
OPPORTUNITY_RADAR_REFRESH_LOOPS=25
OPPORTUNITY_RADAR_REFRESH_SECONDS=60
OPPORTUNITY_RADAR_TOP_N=8
OPPORTUNITY_RADAR_MIN_QUOTE_VOLUME_USDT=2000000

# --- Rage mode (streak-based size multiplier) ---
RAGE_STREAK=3
RAGE_WIN_MULT=1.25
RAGE_LOSS_MULT=0.5

# --- App ---
DB_PATH=trading.db
DASHBOARD_PORT=8501

# Telegram is off by default to keep the live loop lightweight.
TELEGRAM_ENABLED=false
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=
TELEGRAM_HEARTBEAT_INTERVAL=300
